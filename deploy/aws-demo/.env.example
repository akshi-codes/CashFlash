# Replace with the reserved/static public IPv4 address assigned to the server.
PUBLIC_HOST=REPLACE_WITH_STATIC_IPV4
PUBLIC_ORIGIN=https://REPLACE_WITH_STATIC_IPV4

# Use long random values containing letters and numbers only. See README.md.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
MYSQL_APP_USER=cashflash_app
MYSQL_APP_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
