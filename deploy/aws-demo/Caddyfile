{
	default_sni {$PUBLIC_HOST}
}

{$PUBLIC_HOST} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}

	root * /srv

	@backend path /api /api/* /websocket /websocket/* /files /files/*
	handle @backend {
		reverse_proxy api:28080
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
