FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY CashflashBackend/cashflash-main-service/ ./CashflashBackend/cashflash-main-service/
RUN chmod +x CashflashBackend/cashflash-main-service/mvnw && ./CashflashBackend/cashflash-main-service/mvnw -f CashflashBackend/cashflash-main-service/pom.xml -Dmaven.test.skip=true package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/CashflashBackend/cashflash-main-service/target/cashflash-main-service-*.jar /app/app.jar
EXPOSE 28080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
