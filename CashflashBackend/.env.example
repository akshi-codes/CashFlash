# Copy this file to CashflashBackend/.env for local development.
# Keep real passwords and secrets out of Git.

SPRING_DATASOURCE_MAIN_URL=jdbc:mysql://localhost:3306/cashflashdb?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_MAIN_USERNAME=cashflash_app
SPRING_DATASOURCE_MAIN_PASSWORD=replace-with-local-password

SPRING_DATASOURCE_PSP_URL=jdbc:mysql://localhost:3306/cashflash_pspdb?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_PSP_USERNAME=cashflash_psp
SPRING_DATASOURCE_PSP_PASSWORD=replace-with-local-password

JWT_SECRET=replace-with-at-least-32-random-characters
PSP_BASE_URL=http://localhost:8082

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

APP_UPLOAD_PROFILE_DIR=./uploads/profile
APP_UPLOAD_KYC_DIR=./uploads/kyc
APP_UPLOAD_PROFILE_PUBLIC_BASE=/files/profile

SPRING_WEB_ERROR_INCLUDE_MESSAGE=never
SPRING_WEB_ERROR_INCLUDE_BINDING_ERRORS=never
SPRING_WEB_ERROR_INCLUDE_STACKTRACE=never

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_HIBERNATE=WARN
