# Copy this file to CashflashFrontend/frontend/.env for local development.
# Vite exposes variables prefixed with VITE_ to browser code, so do not put secrets here.

VITE_API_ORIGIN=http://localhost:28080
VITE_API_BASE_URL=http://localhost:28080/api
VITE_WS_URL=http://localhost:28080/websocket

VITE_AI_API_BASE_URL=http://localhost:28001

VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_FILES_PROXY_TARGET=http://localhost:28080
