# Copy this file to CashflashFrontend/tools/ai/.env for local AI development.
# Keep database passwords local or provide them through your shell/session.

AI_HOST=127.0.0.1
AI_PORT=28001
AI_ALLOWED_ORIGINS=http://localhost:25174,http://localhost:25175,http://127.0.0.1:25174,http://127.0.0.1:25175

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cashflashdb
DB_USER=cashflash_ai_readonly
DB_PASSWORD=replace-with-readonly-local-password
DB_QUERY_LIMIT=10
AI_PREVIEW_ROWS=10

OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_SQL_MODEL=qwen2.5-coder:1.5b
OLLAMA_RECOMMENDATION_MODEL=qwen2.5-coder:1.5b
OLLAMA_VOICE_MODEL=qwen2.5-coder:1.5b
OLLAMA_KEEP_ALIVE=30m

VOICE_ASR_MODEL_SIZE=small
VOICE_ASR_DEVICE=cpu
VOICE_ASR_COMPUTE_TYPE=int8
